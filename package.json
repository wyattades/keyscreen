    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.14.0",
  "bin": {
    "keyscreen": "src/cli.ts"
  },
  "dependencies": {
    "omggif": "1.0.10",
