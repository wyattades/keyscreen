{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "bun"],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["es2023", "dom", "dom.iterable"]
  },
  "include": ["src", "lab"]
}
